<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avalonia_MVVM_Aplikace_Kral_Friedl.ModelyZobrazeni"
        x:Class="Avalonia_MVVM_Aplikace_Kral_Friedl.Zobrazeni.PridatOkno"
        x:DataType="vm:PridatOknoViewModel"
        Title="Přidat novou knihu / film"
        Width="400" Height="450"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e" Foreground="White">

	<StackPanel Margin="20" Spacing="15">
		<TextBlock Text="Přidat nový záznam" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

		<StackPanel>
			<TextBlock Text="Název:" Foreground="#aaa" Margin="0,0,0,5"/>
			<TextBox Text="{Binding Nazev, Mode=TwoWay}" Background="#2d2d2d" Foreground="White"/>
		</StackPanel>

		<StackPanel>
			<TextBlock Text="Žánr:" Foreground="#aaa" Margin="0,0,0,5"/>
			<ComboBox ItemsSource="{Binding Zanry}" SelectedItem="{Binding VybranyZanr, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="#2d2d2d"/>
		</StackPanel>

		<Grid ColumnDefinitions="*, *">
			<StackPanel Grid.Column="0" Margin="0,0,10,0">
				<TextBlock Text="Délka (min/str):" Foreground="#aaa" Margin="0,0,0,5"/>
				<TextBox Text="{Binding DelkaText, Mode=TwoWay}" Background="#2d2d2d" Foreground="White"/>
			</StackPanel>
			
			<StackPanel Grid.Column="1">
				<TextBlock Text="Hodnocení (1-5):" Foreground="#aaa" Margin="0,0,0,5"/>
				<TextBox Text="{Binding HodnoceniText, Mode=TwoWay}" Background="#2d2d2d" Foreground="White"/>
			</StackPanel>
		</Grid>

		<CheckBox IsChecked="{Binding JePrecteno, Mode=TwoWay}" Content="Přečteno / Viděno" Foreground="White"/>

		<StackPanel>
			<TextBlock Text="Popis:" Foreground="#aaa" Margin="0,0,0,5"/>
			<TextBox Text="{Binding Popis, Mode=TwoWay}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Background="#2d2d2d" Foreground="White"/>
		</StackPanel>

		<TextBlock Text="{Binding ChybaValidace}" Foreground="#ff4d4d" HorizontalAlignment="Center" TextWrapping="Wrap" FontWeight="Bold"/>

		<Grid ColumnDefinitions="*, *">
			<Button Grid.Column="0" Content="Uložit" Command="{Binding UlozitCommand}" HotKey="Enter" Background="#007acc" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
			<Button Grid.Column="1" Content="Zrušit" Command="{Binding ZrusitCommand}" HotKey="Escape" Background="#a80000" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
		</Grid>
	</StackPanel>
</Window>