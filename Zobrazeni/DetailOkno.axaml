<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        xmlns:m="using:Avalonia_MVVM_Aplikace_Kral_Friedl.Modely"
        x:Class="Avalonia_MVVM_Aplikace_Kral_Friedl.Zobrazeni.DetailOkno"
        x:DataType="m:MediaObjekt"
        Title="Detail záznamu"
        Width="400" Height="350"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e" Foreground="White">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{Binding Nazev}" FontSize="22" FontWeight="Bold" Foreground="#007acc" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Zanr}" FontSize="14" Foreground="#aaa" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,15">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Delka, StringFormat='Délka: {0} min/str'}" FontSize="14"/>
                <TextBlock Text="{Binding Hodnoceni, StringFormat='Hodnocení: {0} / 5'}" FontSize="14" FontWeight="Bold" Foreground="#ffcc00"/>
				
                <Border BorderBrush="#3f3f3f" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Popis:" FontWeight="Bold" Foreground="#aaa" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Popis}" TextWrapping="Wrap" FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Zavřít" Click="Zavrit_Click" Background="#2d2d2d" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,5"/>
    </Grid>
</Window>